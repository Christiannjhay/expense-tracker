"use client";

import { useState } from "react";
import { useRouter } from "next/navigation";
import { deleteGoal, updateGoal } from "@/lib/goals/actions";
import {
  GoalForm,
  type GoalFormDefaults,
} from "@/app/target/goals/goal-form";
import { Modal } from "@/app/modal";
import { PencilIcon } from "@/app/icons";
import { useToast } from "@/app/toast-context";
import { DeleteConfirm } from "@/app/delete-confirm";

export function GoalEditModal({
  goalId,
  goalName,
  defaults,
}: {
  goalId: number;
  goalName: string;
  defaults: GoalFormDefaults;
}) {
  const [open, setOpen] = useState(false);
  const router = useRouter();
  const { showToast } = useToast();

  async function handleDelete() {
    const result = await deleteGoal(goalId);
    if (!result.error) {
      showToast("Goal deleted");
      router.push("/target/goals");
    }
    return result;
  }

  return (
    <>
      <button
        type="button"
        onClick={() => setOpen(true)}
        aria-label="Edit goal"
        className="shrink-0 rounded-lg p-1.5 text-[var(--foreground-muted)] hover:bg-zinc-100 hover:text-[var(--foreground-muted)] dark:hover:bg-zinc-900"
      >
        <PencilIcon />
      </button>

      <Modal open={open} onClose={() => setOpen(false)} title="Edit goal">
        <GoalForm
          action={updateGoal.bind(null, goalId)}
          defaults={defaults}
          submitLabel="Save changes"
          pendingLabel="Saving…"
          onSuccess={() => {
            setOpen(false);
            showToast("Goal saved");
            router.refresh();
          }}
        />

        <div className="mt-4 border-t border-[var(--border)] pt-4">
          <DeleteConfirm
            key={String(open)}
            label="Delete goal"
            confirmMessage={`Delete "${goalName}" and all its contributions? This can't be undone.`}
            onConfirm={handleDelete}
          />
        </div>
      </Modal>
    </>
  );
}
