import type { Metadata } from "next";
import Link from "next/link";
import { createClient } from "@/lib/supabase/server";
import { getAuthedUser } from "@/lib/supabase/session";
import { getProfile } from "@/lib/profile/queries";
import { formatMoney } from "@/lib/currency";
import { formatDate } from "@/lib/periods/format";
import { BackLink } from "@/app/back-link";
import { FlagIcon, PlusIcon } from "@/app/icons";
import { EmptyState } from "@/app/empty-state";
import { GoalRow } from "./goal-row";

export const metadata: Metadata = {
  title: "Goals — Expense Tracker",
};

type GoalWithContributions = {
  id: number;
  name: string;
  target_date: string;
  goal_contributions: { amount: number }[];
};

export default async function GoalsPage() {
  const supabase = await createClient();

  const [user, { data: goals, error }] = await Promise.all([
    getAuthedUser(),
    supabase
      .from("goals")
      .select("id, name, target_date, goal_contributions(amount)")
      .order("created_at", { ascending: false })
      .returns<GoalWithContributions[]>(),
  ]);

  if (!user) {
    return null;
  }

  const profile = await getProfile(user.id);

  return (
    <main className="mx-auto w-full max-w-4xl flex-1 px-4 py-10">
      <BackLink href="/target" />

      <div className="mt-4 flex items-center justify-between">
        <h1 className="text-2xl font-semibold text-[var(--foreground)]">
          Goals
        </h1>
        <Link
          href="/target/goals/new"
          className="flex h-10 items-center gap-1.5 rounded-lg bg-[var(--accent)] px-4 text-sm font-medium text-[var(--accent-fg)] transition-colors hover:bg-[var(--accent-hover)]"
        >
          <PlusIcon />
          New goal
        </Link>
      </div>

      {error && (
        <p role="alert" className="mt-6 text-sm text-red-600 dark:text-red-400">
          {error.message}
        </p>
      )}

      {!error && goals && goals.length === 0 && (
        <EmptyState
          icon={FlagIcon}
          title="No goals created"
          description="Add one to start saving toward it."
        />
      )}

      {!error && goals && goals.length > 0 && (
        <>
          {/* Mobile: stacked cards */}
          <div className="mt-6 flex flex-col gap-3 sm:hidden">
            {goals.map((goal) => {
              const totalSaved = goal.goal_contributions.reduce(
                (sum, c) => sum + c.amount,
                0
              );
              return (
                <Link
                  key={goal.id}
                  href={`/target/goals/${goal.id}`}
                  className="flex flex-col gap-2 rounded-xl border border-[var(--border)] bg-transparent p-4 active:bg-[var(--hover-bg)] dark:bg-zinc-950"
                >
                  <div className="flex items-center justify-between gap-2">
                    <span className="font-semibold text-[var(--foreground)]">
                      {goal.name}
                    </span>
                    <span className="shrink-0 text-xs text-[var(--foreground-muted)]">
                      {formatDate(goal.target_date)}
                    </span>
                  </div>
                  <div className="flex items-center justify-between text-sm text-[var(--foreground-muted)]">
                    <span>Total saved</span>
                    <span>{formatMoney(totalSaved, profile.currency)}</span>
                  </div>
                </Link>
              );
            })}
          </div>

          {/* sm and up: table */}
          <div className="mt-6 hidden overflow-x-auto rounded-xl border border-[var(--border)] sm:block">
            <table className="w-full text-left text-sm">
              <thead className="bg-[var(--thead-bg)] text-xs uppercase tracking-wide text-[var(--foreground-muted)]">
                <tr>
                  <th className="px-4 py-3 font-medium">Name</th>
                  <th className="px-4 py-3 font-medium">Target date</th>
                  <th className="px-4 py-3 font-medium">Total saved</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-[var(--border)]">
                {goals.map((goal) => {
                  const totalSaved = goal.goal_contributions.reduce(
                    (sum, c) => sum + c.amount,
                    0
                  );
                  return (
                    <GoalRow
                      key={goal.id}
                      id={goal.id}
                      name={goal.name}
                      targetDate={formatDate(goal.target_date)}
                      totalSaved={formatMoney(totalSaved, profile.currency)}
                    />
                  );
                })}
              </tbody>
            </table>
          </div>
        </>
      )}
    </main>
  );
}
