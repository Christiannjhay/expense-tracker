"use client";

import { useState } from "react";
import { useRouter } from "next/navigation";
import { deleteDebt, updateDebt } from "@/lib/debts/actions";
import {
  DebtForm,
  type DebtFormDefaults,
} from "@/app/target/debt-tracker/debt-form";
import { Modal } from "@/app/modal";
import { PencilIcon } from "@/app/icons";
import { useToast } from "@/app/toast-context";
import { DeleteConfirm } from "@/app/delete-confirm";

export function DebtEditModal({
  debtId,
  debtName,
  defaults,
}: {
  debtId: number;
  debtName: string;
  defaults: DebtFormDefaults;
}) {
  const [open, setOpen] = useState(false);
  const router = useRouter();
  const { showToast } = useToast();

  async function handleDelete() {
    const result = await deleteDebt(debtId);
    if (!result.error) {
      showToast("Debt deleted");
      router.push("/target/debt-tracker");
    }
    return result;
  }

  return (
    <>
      <button
        type="button"
        onClick={() => setOpen(true)}
        aria-label="Edit debt"
        className="shrink-0 rounded-lg p-1.5 text-[var(--foreground-muted)] hover:bg-zinc-100 hover:text-[var(--foreground-muted)] dark:hover:bg-zinc-900"
      >
        <PencilIcon />
      </button>

      <Modal open={open} onClose={() => setOpen(false)} title="Edit debt">
        <DebtForm
          action={updateDebt.bind(null, debtId)}
          defaults={defaults}
          submitLabel="Save changes"
          pendingLabel="Saving…"
          onSuccess={() => {
            setOpen(false);
            showToast("Debt saved");
            router.refresh();
          }}
        />

        <div className="mt-4 border-t border-zinc-200 pt-4 dark:border-zinc-800">
          <DeleteConfirm
            key={String(open)}
            label="Delete debt"
            confirmMessage={`Delete "${debtName}" and all its payments? This can't be undone.`}
            onConfirm={handleDelete}
          />
        </div>
      </Modal>
    </>
  );
}
