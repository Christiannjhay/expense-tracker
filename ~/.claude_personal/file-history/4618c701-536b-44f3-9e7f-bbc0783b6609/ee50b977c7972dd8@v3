"use client";

import { useState } from "react";

export function DeleteConfirm({
  label,
  confirmMessage,
  onConfirm,
}: {
  label: string;
  confirmMessage: string;
  onConfirm: () => Promise<{ error: string | null }>;
}) {
  const [confirming, setConfirming] = useState(false);
  const [pending, setPending] = useState(false);
  const [error, setError] = useState<string | null>(null);

  if (!confirming) {
    return (
      <button
        type="button"
        onClick={() => {
          setError(null);
          setConfirming(true);
        }}
        className="flex h-10 w-full items-center justify-center rounded-lg bg-red-600 text-sm font-medium text-white transition-colors hover:bg-red-700"
      >
        {label}
      </button>
    );
  }

  return (
    <div className="flex flex-col gap-2">
      <p className="text-center text-sm text-[var(--foreground-muted)]">
        {confirmMessage}
      </p>

      {error && (
        <p
          role="alert"
          className="text-center text-sm text-red-600 dark:text-red-400"
        >
          {error}
        </p>
      )}

      <div className="flex gap-2">
        <button
          type="button"
          onClick={() => setConfirming(false)}
          disabled={pending}
          className="flex h-10 flex-1 items-center justify-center rounded-lg border border-zinc-300 text-sm font-medium text-[var(--foreground-muted)] transition-colors hover:bg-zinc-100 disabled:cursor-not-allowed disabled:opacity-60 dark:border-zinc-700 dark:hover:bg-zinc-900"
        >
          Cancel
        </button>
        <button
          type="button"
          onClick={async () => {
            setPending(true);
            setError(null);
            const result = await onConfirm();
            if (result.error) {
              setError(result.error);
              setPending(false);
            }
            // On success we deliberately leave pending=true and don't
            // reset — the caller closes the modal or navigates away.
          }}
          disabled={pending}
          className="flex h-10 flex-1 items-center justify-center rounded-lg bg-red-600 text-sm font-medium text-white transition-colors hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-60"
        >
          {pending ? "Deleting…" : "Yes, delete"}
        </button>
      </div>
    </div>
  );
}
