import Link from "next/link";
import { getAuthedUser } from "@/lib/supabase/session";
import { ProfileMenu } from "./profile-menu";
import { HomeIcon, TargetIcon } from "@/app/icons";

const itemClass =
  "flex flex-1 items-center justify-center rounded-lg p-3 text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-50";

export async function Nav() {
  const user = await getAuthedUser();

  return (
    <nav className="fixed inset-x-0 bottom-0 z-40 border-t border-zinc-200 bg-white pb-[env(safe-area-inset-bottom)] dark:border-zinc-800 dark:bg-zinc-950">
      <div className="mx-auto flex max-w-4xl items-center px-2 py-1">
        <Link href="/" aria-label="Home" className={itemClass}>
          <HomeIcon />
        </Link>

        {user && (
          <>
            <Link href="/periods" aria-label="Periods" className={itemClass}>
              <TargetIcon />
            </Link>
            <ProfileMenu />
          </>
        )}
      </div>
    </nav>
  );
}
