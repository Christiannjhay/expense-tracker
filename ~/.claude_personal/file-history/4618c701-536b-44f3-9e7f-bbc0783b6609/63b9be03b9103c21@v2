import type { Metadata } from "next";
import { notFound } from "next/navigation";
import { createClient } from "@/lib/supabase/server";
import { updateExpense } from "@/lib/expenses/actions";
import type { Expense } from "@/lib/expenses/types";
import { BackLink } from "@/app/back-link";
import { ExpenseForm } from "@/app/periods/[id]/expense-form";

export const metadata: Metadata = {
  title: "Edit expense — Expense Tracker",
};

export default async function EditExpensePage({
  params,
}: {
  params: Promise<{ id: string; expenseId: string }>;
}) {
  const { id, expenseId } = await params;
  const supabase = await createClient();

  const [{ data: expense }, { data: categories }] = await Promise.all([
    supabase
      .from("expenses")
      .select("*")
      .eq("id", expenseId)
      .eq("period_id", id)
      .maybeSingle<Expense>(),
    supabase.from("categories").select("id, name").order("name"),
  ]);

  if (!expense) {
    notFound();
  }

  return (
    <main className="mx-auto w-full max-w-lg flex-1 px-4 py-10">
      <BackLink href={`/periods/${id}`} />

      <h1 className="mt-4 text-2xl font-semibold text-zinc-900 dark:text-zinc-50">
        Edit expense
      </h1>

      <ExpenseForm
        action={updateExpense.bind(null, expense.id, Number(id))}
        categories={categories ?? []}
        defaults={{
          category_id: expense.category_id,
          amount: expense.amount,
          description: expense.description,
          spent_at: expense.spent_at,
        }}
        submitLabel="Save changes"
        pendingLabel="Saving…"
      />
    </main>
  );
}
