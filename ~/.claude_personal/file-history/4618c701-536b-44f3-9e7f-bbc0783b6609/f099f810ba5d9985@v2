"use server";

import { redirect } from "next/navigation";
import { createClient } from "@/lib/supabase/server";

export type PeriodFormState = {
  error: string | null;
};

export async function createPeriod(
  _prevState: PeriodFormState,
  formData: FormData
): Promise<PeriodFormState> {
  const supabase = await createClient();
  const {
    data: { user },
  } = await supabase.auth.getUser();

  if (!user) {
    return { error: "You must be logged in." };
  }

  const name = formData.get("name");
  const type = formData.get("type");
  const totalBudgetRaw = formData.get("total_budget");

  if (typeof name !== "string" || name.trim().length === 0) {
    return { error: "Name is required." };
  }

  if (type !== "month" && type !== "trip") {
    return { error: "Choose a period type." };
  }

  let totalBudget: number | null = null;
  if (typeof totalBudgetRaw === "string" && totalBudgetRaw.trim() !== "") {
    totalBudget = Number(totalBudgetRaw);
    if (Number.isNaN(totalBudget) || totalBudget < 0) {
      return { error: "Budget must be a positive number." };
    }
  }

  const insert: {
    user_id: string;
    name: string;
    type: "month" | "trip";
    total_budget: number | null;
    year?: number;
    month?: number;
    start_date?: string;
    end_date?: string;
  } = {
    user_id: user.id,
    name: name.trim(),
    type,
    total_budget: totalBudget,
  };

  if (type === "month") {
    const year = Number(formData.get("year"));
    const month = Number(formData.get("month"));
    if (
      !Number.isInteger(year) ||
      !Number.isInteger(month) ||
      month < 1 ||
      month > 12
    ) {
      return { error: "Enter a valid year and month." };
    }
    insert.year = year;
    insert.month = month;
  } else {
    const startDate = formData.get("start_date");
    const endDate = formData.get("end_date");
    if (
      typeof startDate !== "string" ||
      typeof endDate !== "string" ||
      !startDate ||
      !endDate
    ) {
      return { error: "Enter a start and end date." };
    }
    if (startDate > endDate) {
      return { error: "Start date must be before end date." };
    }
    insert.start_date = startDate;
    insert.end_date = endDate;
  }

  const { data: period, error } = await supabase
    .from("periods")
    .insert(insert)
    .select("id")
    .single();

  if (error) {
    return { error: error.message };
  }

  redirect(`/periods/${period.id}`);
}
