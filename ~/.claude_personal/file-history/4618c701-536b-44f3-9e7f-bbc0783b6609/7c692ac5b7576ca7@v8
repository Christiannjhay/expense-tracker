"use client";

import { useState } from "react";
import { useRouter } from "next/navigation";
import { deleteExpense, updateExpense } from "@/lib/expenses/actions";
import { ExpenseForm } from "@/app/periods/[id]/expense-form";
import { Modal } from "@/app/modal";
import { DeleteConfirm } from "@/app/delete-confirm";
import { formatBudget, formatDate } from "@/lib/periods/format";
import { useToast } from "@/app/toast-context";

type ExpenseData = {
  id: number;
  category_id: number;
  amount: number;
  description: string | null;
  spent_at: string;
  categories: { name: string } | null;
};

function useExpenseEditModal(periodId: number, expenseId: number) {
  const [open, setOpen] = useState(false);
  const router = useRouter();
  const { showToast } = useToast();

  async function handleDelete() {
    const result = await deleteExpense(periodId, expenseId);
    if (!result.error) {
      setOpen(false);
      showToast("Expense deleted");
      router.refresh();
    }
    return result;
  }

  function handleSuccess() {
    setOpen(false);
    showToast("Expense saved");
    router.refresh();
  }

  return { open, setOpen, handleDelete, handleSuccess };
}

function EditExpenseModalBody({
  periodId,
  expense,
  categories,
  context,
  open,
  onSuccess,
  onDelete,
}: {
  periodId: number;
  expense: ExpenseData;
  categories: { id: number; name: string }[];
  context: "general" | "trip";
  open: boolean;
  onSuccess: () => void;
  onDelete: () => Promise<{ error: string | null }>;
}) {
  return (
    <>
      <ExpenseForm
        action={updateExpense.bind(null, periodId, expense.id)}
        categories={categories}
        context={context}
        defaults={{
          category_id: expense.category_id,
          amount: expense.amount,
          description: expense.description,
          spent_at: expense.spent_at,
        }}
        submitLabel="Save changes"
        pendingLabel="Saving…"
        onSuccess={onSuccess}
      />
      <div className="mt-4 border-t border-zinc-200 pt-4 dark:border-zinc-800">
        <DeleteConfirm
          key={String(open)}
          label="Delete expense"
          confirmMessage="Delete this expense? This can't be undone."
          onConfirm={onDelete}
        />
      </div>
    </>
  );
}

export function ExpenseCard({
  periodId,
  expense,
  categories,
  context,
  currency,
}: {
  periodId: number;
  expense: ExpenseData;
  categories: { id: number; name: string }[];
  context: "general" | "trip";
  currency: string;
}) {
  const { open, setOpen, handleDelete, handleSuccess } = useExpenseEditModal(
    periodId,
    expense.id
  );

  return (
    <>
      <button
        type="button"
        onClick={() => setOpen(true)}
        className="w-full rounded-xl border border-zinc-200 bg-white p-4 text-left active:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-950 dark:active:bg-zinc-900"
      >
        <div className="flex items-center justify-between gap-2">
          <span className="font-medium text-zinc-900 dark:text-zinc-50">
            {formatBudget(expense.amount, currency)}
          </span>
          <span className="shrink-0 text-xs text-zinc-500 dark:text-zinc-400">
            {formatDate(expense.spent_at)}
          </span>
        </div>
        <div className="mt-1 flex items-center justify-between gap-2 text-sm text-zinc-600 dark:text-zinc-400">
          <span>{expense.categories?.name ?? "—"}</span>
          {expense.description && (
            <span className="truncate text-right">
              {expense.description}
            </span>
          )}
        </div>
      </button>

      <Modal open={open} onClose={() => setOpen(false)} title="Edit expense">
        <EditExpenseModalBody
          periodId={periodId}
          expense={expense}
          categories={categories}
          context={context}
          open={open}
          onSuccess={handleSuccess}
          onDelete={handleDelete}
        />
      </Modal>
    </>
  );
}

export function ExpenseTableRow({
  periodId,
  expense,
  categories,
  context,
  currency,
}: {
  periodId: number;
  expense: ExpenseData;
  categories: { id: number; name: string }[];
  context: "general" | "trip";
  currency: string;
}) {
  const { open, setOpen, handleDelete, handleSuccess } = useExpenseEditModal(
    periodId,
    expense.id
  );

  return (
    <>
      <tr
        onClick={() => setOpen(true)}
        className="cursor-pointer hover:bg-zinc-50 dark:hover:bg-zinc-900"
      >
        <td className="px-4 py-3 text-zinc-600 dark:text-zinc-400">
          {formatDate(expense.spent_at)}
        </td>
        <td className="px-4 py-3 text-zinc-600 dark:text-zinc-400">
          {expense.categories?.name ?? "—"}
        </td>
        <td className="px-4 py-3 text-zinc-600 dark:text-zinc-400">
          {expense.description ?? "—"}
        </td>
        <td className="px-4 py-3 text-zinc-900 dark:text-zinc-50">
          {formatBudget(expense.amount, currency)}
        </td>
      </tr>

      <Modal open={open} onClose={() => setOpen(false)} title="Edit expense">
        <EditExpenseModalBody
          periodId={periodId}
          expense={expense}
          categories={categories}
          context={context}
          open={open}
          onSuccess={handleSuccess}
          onDelete={handleDelete}
        />
      </Modal>
    </>
  );
}
