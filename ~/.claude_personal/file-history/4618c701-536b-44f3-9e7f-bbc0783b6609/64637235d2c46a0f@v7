import type { Metadata } from "next";
import { notFound } from "next/navigation";
import { createClient } from "@/lib/supabase/server";
import { createExpense } from "@/lib/expenses/actions";
import type { Period } from "@/lib/periods/types";
import { BackLink } from "@/app/back-link";
import { ExpenseForm } from "@/app/periods/[id]/expense-form";

export const metadata: Metadata = {
  title: "Add expense — Expense Tracker",
};

export default async function NewExpensePage({
  params,
}: {
  params: Promise<{ id: string }>;
}) {
  const { id } = await params;
  const supabase = await createClient();

  const { data: period } = await supabase
    .from("periods")
    .select("*")
    .eq("id", id)
    .maybeSingle<Period>();

  if (!period) {
    notFound();
  }

  const context = period.type === "trip" ? "trip" : "general";
  const { data: categories } = await supabase
    .from("categories")
    .select("id, name")
    .eq("context", context)
    .order("name");

  return (
    <main className="mx-auto w-full max-w-lg flex-1 px-4 py-10">
      <BackLink href={`/periods/${period.id}`} />

      <h1 className="mt-4 text-2xl font-semibold text-[var(--foreground)]">
        Add expense
      </h1>
      <p className="mt-1 text-sm text-[var(--foreground-muted)]">
        This expense will be added to {period.name} only.
      </p>

      <ExpenseForm
        action={createExpense.bind(null, period.id)}
        categories={categories ?? []}
        context={context}
      />
    </main>
  );
}
