import type { Metadata } from "next";
import Link from "next/link";
import { createClient } from "@/lib/supabase/server";
import { getAuthedUser } from "@/lib/supabase/session";
import { getProfile } from "@/lib/profile/queries";
import { formatMoney } from "@/lib/currency";
import { formatDate } from "@/lib/periods/format";
import { BackLink } from "@/app/back-link";
import { BanknotesIcon, PlusIcon } from "@/app/icons";
import { EmptyState } from "@/app/empty-state";
import { DebtRow } from "./debt-row";

export const metadata: Metadata = {
  title: "Debt Tracker — Expense Tracker",
};

type DebtWithPayments = {
  id: number;
  name: string;
  total_amount: number;
  started_at: string;
  debt_payments: { amount: number }[];
};

export default async function DebtTrackerPage() {
  const supabase = await createClient();

  const [user, { data: debts, error }] = await Promise.all([
    getAuthedUser(),
    supabase
      .from("debts")
      .select("id, name, total_amount, started_at, debt_payments(amount)")
      .order("created_at", { ascending: false })
      .returns<DebtWithPayments[]>(),
  ]);

  if (!user) {
    return null;
  }

  const profile = await getProfile(user.id);

  return (
    <main className="mx-auto w-full max-w-4xl flex-1 px-4 py-10">
      <BackLink href="/target" />

      <div className="mt-4 flex items-center justify-between">
        <h1 className="text-2xl font-semibold text-zinc-900 dark:text-zinc-50">
          Debt Tracker
        </h1>
        <Link
          href="/target/debt-tracker/new"
          className="flex h-10 items-center gap-1.5 rounded-lg bg-zinc-900 px-4 text-sm font-medium text-white transition-colors hover:bg-zinc-800 dark:bg-zinc-50 dark:text-zinc-900 dark:hover:bg-zinc-200"
        >
          <PlusIcon />
          New debt
        </Link>
      </div>

      {error && (
        <p role="alert" className="mt-6 text-sm text-red-600 dark:text-red-400">
          {error.message}
        </p>
      )}

      {!error && debts && debts.length === 0 && (
        <EmptyState
          icon={BanknotesIcon}
          title="No debts created"
          description="Add one to start tracking payments."
        />
      )}

      {!error && debts && debts.length > 0 && (
        <>
          {/* Mobile: stacked cards */}
          <div className="mt-6 flex flex-col gap-3 sm:hidden">
            {debts.map((debt) => {
              const totalPaid = debt.debt_payments.reduce(
                (sum, p) => sum + p.amount,
                0
              );
              return (
                <Link
                  key={debt.id}
                  href={`/target/debt-tracker/${debt.id}`}
                  className="flex flex-col gap-2 rounded-xl border border-zinc-200 bg-white p-4 active:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-950 dark:active:bg-zinc-900"
                >
                  <div className="flex items-center justify-between gap-2">
                    <span className="font-semibold text-zinc-900 dark:text-zinc-50">
                      {debt.name}
                    </span>
                    <span className="shrink-0 text-xs text-zinc-500 dark:text-zinc-400">
                      {formatDate(debt.started_at)}
                    </span>
                  </div>
                  <div className="flex items-center justify-between text-sm text-zinc-600 dark:text-zinc-400">
                    <span>Total paid</span>
                    <span>
                      {formatMoney(totalPaid, profile.currency)} of{" "}
                      {formatMoney(debt.total_amount, profile.currency)}
                    </span>
                  </div>
                </Link>
              );
            })}
          </div>

          {/* sm and up: table */}
          <div className="mt-6 hidden overflow-x-auto rounded-xl border border-zinc-200 dark:border-zinc-800 sm:block">
            <table className="w-full text-left text-sm">
              <thead className="bg-zinc-50 text-xs uppercase tracking-wide text-zinc-500 dark:bg-zinc-900 dark:text-zinc-400">
                <tr>
                  <th className="px-4 py-3 font-medium">Name</th>
                  <th className="px-4 py-3 font-medium">Date</th>
                  <th className="px-4 py-3 font-medium">Total paid</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-zinc-200 dark:divide-zinc-800">
                {debts.map((debt) => {
                  const totalPaid = debt.debt_payments.reduce(
                    (sum, p) => sum + p.amount,
                    0
                  );
                  return (
                    <DebtRow
                      key={debt.id}
                      id={debt.id}
                      name={debt.name}
                      startedAt={formatDate(debt.started_at)}
                      totalPaid={`${formatMoney(
                        totalPaid,
                        profile.currency
                      )} of ${formatMoney(
                        debt.total_amount,
                        profile.currency
                      )}`}
                    />
                  );
                })}
              </tbody>
            </table>
          </div>
        </>
      )}
    </main>
  );
}
