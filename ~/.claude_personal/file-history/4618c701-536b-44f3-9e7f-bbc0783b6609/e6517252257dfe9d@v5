export function PeriodTypeIcon({
  type,
  className = "h-4 w-4 text-zinc-400 dark:text-zinc-500",
}: {
  type: string;
} & IconProps) {
  if (type === "trip") return <BriefcaseIcon className={className} />;
  if (type === "period") return <FlagIcon className={className} />;
  return <CalendarIcon className={className} />;
}
