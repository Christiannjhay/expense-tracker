"use client";

import { useState } from "react";
import { useRouter } from "next/navigation";
import { deleteContribution, updateContribution } from "@/lib/goals/actions";
import { ContributionForm } from "@/app/target/goals/contribution-form";
import { Modal } from "@/app/modal";
import { DeleteConfirm } from "@/app/delete-confirm";
import { formatMoney } from "@/lib/currency";
import { formatDate } from "@/lib/periods/format";
import { useToast } from "@/app/toast-context";

type ContributionData = {
  id: number;
  amount: number;
  contributed_at: string;
};

function useContributionEditModal(goalId: number, contributionId: number) {
  const [open, setOpen] = useState(false);
  const router = useRouter();
  const { showToast } = useToast();

  async function handleDelete() {
    const result = await deleteContribution(goalId, contributionId);
    if (!result.error) {
      setOpen(false);
      showToast("Contribution deleted");
      router.refresh();
    }
    return result;
  }

  function handleSuccess() {
    setOpen(false);
    showToast("Contribution saved");
    router.refresh();
  }

  return { open, setOpen, handleDelete, handleSuccess };
}

function EditContributionModalBody({
  goalId,
  contribution,
  open,
  onSuccess,
  onDelete,
}: {
  goalId: number;
  contribution: ContributionData;
  open: boolean;
  onSuccess: () => void;
  onDelete: () => Promise<{ error: string | null }>;
}) {
  return (
    <>
      <ContributionForm
        action={updateContribution.bind(null, goalId, contribution.id)}
        defaults={{
          amount: contribution.amount,
          contributed_at: contribution.contributed_at,
        }}
        submitLabel="Save changes"
        pendingLabel="Saving…"
        onSuccess={onSuccess}
      />
      <div className="mt-4 border-t border-zinc-200 pt-4 dark:border-zinc-800">
        <DeleteConfirm
          key={String(open)}
          label="Delete contribution"
          confirmMessage="Delete this contribution? This can't be undone."
          onConfirm={onDelete}
        />
      </div>
    </>
  );
}

export function ContributionCard({
  goalId,
  contribution,
  currency,
}: {
  goalId: number;
  contribution: ContributionData;
  currency: string;
}) {
  const { open, setOpen, handleDelete, handleSuccess } =
    useContributionEditModal(goalId, contribution.id);

  return (
    <>
      <button
        type="button"
        onClick={() => setOpen(true)}
        className="flex w-full items-center justify-between gap-2 rounded-xl border border-zinc-200 bg-transparent p-4 text-left active:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-950 dark:active:bg-zinc-900"
      >
        <span className="font-medium text-[var(--foreground)]">
          {formatMoney(contribution.amount, currency)}
        </span>
        <span className="shrink-0 text-xs text-[var(--foreground-muted)]">
          {formatDate(contribution.contributed_at)}
        </span>
      </button>

      <Modal
        open={open}
        onClose={() => setOpen(false)}
        title="Edit contribution"
      >
        <EditContributionModalBody
          goalId={goalId}
          contribution={contribution}
          open={open}
          onSuccess={handleSuccess}
          onDelete={handleDelete}
        />
      </Modal>
    </>
  );
}

export function ContributionTableRow({
  goalId,
  contribution,
  currency,
}: {
  goalId: number;
  contribution: ContributionData;
  currency: string;
}) {
  const { open, setOpen, handleDelete, handleSuccess } =
    useContributionEditModal(goalId, contribution.id);

  return (
    <>
      <tr
        onClick={() => setOpen(true)}
        className="cursor-pointer hover:bg-zinc-50 dark:hover:bg-zinc-900"
      >
        <td className="px-4 py-3 text-[var(--foreground-muted)]">
          {formatDate(contribution.contributed_at)}
        </td>
        <td className="px-4 py-3 text-[var(--foreground)]">
          {formatMoney(contribution.amount, currency)}
        </td>
      </tr>

      <Modal
        open={open}
        onClose={() => setOpen(false)}
        title="Edit contribution"
      >
        <EditContributionModalBody
          goalId={goalId}
          contribution={contribution}
          open={open}
          onSuccess={handleSuccess}
          onDelete={handleDelete}
        />
      </Modal>
    </>
  );
}
