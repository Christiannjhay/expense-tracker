import type { Metadata } from "next";
import Link from "next/link";
import { createClient } from "@/lib/supabase/server";
import { formatBudget, formatPeriodRange } from "@/lib/periods/format";
import { formatMoney } from "@/lib/currency";
import type { Period } from "@/lib/periods/types";
import { getProfile } from "@/lib/profile/queries";
import { aggregateByCategory } from "@/lib/expenses/aggregate";
import {
  BanknotesIcon,
  CalendarIcon,
  ChartBarIcon,
  MapIcon,
  PlusIcon,
  RectangleStackIcon,
  WalletIcon,
} from "@/app/icons";
import { PeriodRow } from "./period-row";
import { SpendingByCategory } from "./spending-by-category";

export const metadata: Metadata = {
  title: "Periods — Expense Tracker",
};

export default async function PeriodsPage() {
  const supabase = await createClient();
  const {
    data: { user },
  } = await supabase.auth.getUser();
  if (!user) {
    return null;
  }

  const [{ data: periods, error }, { data: expenses }, profile] =
    await Promise.all([
      supabase
        .from("periods")
        .select("*")
        .order("created_at", { ascending: false })
        .returns<Period[]>(),
      supabase
        .from("expenses")
        .select("amount, categories(name)")
        .returns<{ amount: number; categories: { name: string } | null }[]>(),
      getProfile(supabase, user.id),
    ]);

  const showBudget =
    periods?.some((period) => period.total_budget != null) ?? false;

  const totalBudget = (periods ?? []).reduce(
    (sum, p) => sum + (p.total_budget ?? 0),
    0
  );
  const totalSpent = (expenses ?? []).reduce((sum, e) => sum + e.amount, 0);
  const categorySlices = aggregateByCategory(expenses ?? []);

  return (
    <main className="mx-auto w-full max-w-4xl flex-1 px-4 py-10">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-semibold text-zinc-900 dark:text-zinc-50">
          Periods
        </h1>
        <Link
          href="/periods/new"
          className="flex h-10 items-center gap-1.5 rounded-lg bg-zinc-900 px-4 text-sm font-medium text-white transition-colors hover:bg-zinc-800 dark:bg-zinc-50 dark:text-zinc-900 dark:hover:bg-zinc-200"
        >
          <PlusIcon />
          New period
        </Link>
      </div>

      <div className="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div className="flex items-center gap-3 rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-950">
          <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-zinc-100 text-zinc-900 dark:bg-zinc-800 dark:text-zinc-50">
            <WalletIcon />
          </span>
          <div>
            <p className="text-xs text-zinc-500 dark:text-zinc-400">
              Total budget
            </p>
            <p className="font-semibold text-zinc-900 dark:text-zinc-50">
              {formatBudget(totalBudget > 0 ? totalBudget : null, profile.currency)}
            </p>
          </div>
        </div>

        <div className="flex items-center gap-3 rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-950">
          <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-zinc-100 text-zinc-900 dark:bg-zinc-800 dark:text-zinc-50">
            <BanknotesIcon />
          </span>
          <div>
            <p className="text-xs text-zinc-500 dark:text-zinc-400">
              Total spent
            </p>
            <p className="font-semibold text-zinc-900 dark:text-zinc-50">
              {formatMoney(totalSpent, profile.currency)}
            </p>
          </div>
        </div>

        <div className="flex items-center gap-3 rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-950">
          <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-zinc-100 text-zinc-900 dark:bg-zinc-800 dark:text-zinc-50">
            <RectangleStackIcon />
          </span>
          <div>
            <p className="text-xs text-zinc-500 dark:text-zinc-400">
              Periods
            </p>
            <p className="font-semibold text-zinc-900 dark:text-zinc-50">
              {periods?.length ?? 0}
            </p>
          </div>
        </div>
      </div>

      <div className="mt-4 rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-950">
        <h2 className="flex items-center gap-2 text-sm font-semibold text-zinc-900 dark:text-zinc-50">
          <ChartBarIcon className="h-4 w-4 text-zinc-400 dark:text-zinc-500" />
          Spending by category
        </h2>
        <div className="mt-3">
          <SpendingByCategory
            slices={categorySlices}
            currency={profile.currency}
            showTotal={false}
          />
        </div>
      </div>

      {error && (
        <p role="alert" className="mt-6 text-sm text-red-600 dark:text-red-400">
          {error.message}
        </p>
      )}

      {!error && periods && periods.length === 0 && (
        <p className="mt-6 text-sm text-zinc-500 dark:text-zinc-400">
          No periods yet. Create one to start tracking expenses.
        </p>
      )}

      {!error && periods && periods.length > 0 && (
        <>
          {/* Mobile: stacked cards — a 4-column table reads too tight below sm. */}
          <div className="mt-6 flex flex-col gap-3 sm:hidden">
            {periods.map((period) => (
              <Link
                key={period.id}
                href={`/periods/${period.id}`}
                className="flex flex-col gap-2 rounded-xl border border-zinc-200 bg-white p-4 active:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-950 dark:active:bg-zinc-900"
              >
                <div className="flex items-center justify-between gap-2">
                  <span className="font-semibold text-zinc-900 dark:text-zinc-50">
                    {period.name}
                  </span>
                  <span className="inline-flex shrink-0 items-center gap-1 text-xs capitalize text-zinc-500 dark:text-zinc-400">
                    {period.type === "trip" ? (
                      <MapIcon className="h-3.5 w-3.5" />
                    ) : (
                      <CalendarIcon className="h-3.5 w-3.5 text-white" />
                    )}
                    {period.type}
                  </span>
                </div>
                <div className="flex items-center justify-between text-sm text-zinc-600 dark:text-zinc-400">
                  <span>{formatPeriodRange(period)}</span>
                  {period.total_budget != null && (
                    <span>
                      {formatBudget(period.total_budget, profile.currency)}
                    </span>
                  )}
                </div>
              </Link>
            ))}
          </div>

          {/* sm and up: table */}
          <div className="mt-6 hidden overflow-x-auto rounded-xl border border-zinc-200 dark:border-zinc-800 sm:block">
            <table className="w-full text-left text-sm">
              <thead className="bg-zinc-50 text-xs uppercase tracking-wide text-zinc-500 dark:bg-zinc-900 dark:text-zinc-400">
                <tr>
                  <th className="px-4 py-3 font-medium">Name</th>
                  <th className="px-4 py-3 font-medium">Type</th>
                  <th className="px-4 py-3 font-medium">When</th>
                  {showBudget && (
                    <th className="px-4 py-3 font-medium">Budget</th>
                  )}
                </tr>
              </thead>
              <tbody className="divide-y divide-zinc-200 dark:divide-zinc-800">
                {periods.map((period) => (
                  <PeriodRow
                    key={period.id}
                    id={period.id}
                    name={period.name}
                    type={period.type}
                    when={formatPeriodRange(period)}
                    budget={formatBudget(period.total_budget, profile.currency)}
                    showBudget={showBudget}
                  />
                ))}
              </tbody>
            </table>
          </div>
        </>
      )}
    </main>
  );
}
