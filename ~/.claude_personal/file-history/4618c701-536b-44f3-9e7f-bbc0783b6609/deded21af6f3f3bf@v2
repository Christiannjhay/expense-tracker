import type { Metadata } from "next";
import { notFound } from "next/navigation";
import { createClient } from "@/lib/supabase/server";
import { updatePeriod } from "@/lib/periods/actions";
import type { Period } from "@/lib/periods/types";
import { BackLink } from "@/app/back-link";
import { PeriodForm } from "@/app/periods/period-form";

export const metadata: Metadata = {
  title: "Edit period — Expense Tracker",
};

export default async function EditPeriodPage({
  params,
}: {
  params: Promise<{ id: string }>;
}) {
  const { id } = await params;
  const supabase = await createClient();

  const { data: period } = await supabase
    .from("periods")
    .select("*")
    .eq("id", id)
    .maybeSingle<Period>();

  if (!period) {
    notFound();
  }

  const updatePeriodForId = updatePeriod.bind(null, period.id);

  return (
    <main className="mx-auto w-full max-w-lg flex-1 px-4 py-10">
      <BackLink href={`/periods/${period.id}`} />

      <h1 className="mt-4 text-2xl font-semibold text-zinc-900 dark:text-zinc-50">
        Edit period
      </h1>

      <PeriodForm
        action={updatePeriodForId}
        defaults={{
          name: period.name,
          type: period.type,
          year: period.year,
          month: period.month,
          start_date: period.start_date,
          end_date: period.end_date,
          total_budget: period.total_budget,
        }}
        submitLabel="Save changes"
        pendingLabel="Saving…"
      />
    </main>
  );
}
